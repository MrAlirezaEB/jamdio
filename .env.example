APP_NAME=Jamdio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=jamdio
DB_USERNAME=jamdio
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Laravel Reverb (WebSockets) ---
REVERB_APP_ID=jamdio
REVERB_APP_KEY=jamdio-key
REVERB_APP_SECRET=jamdio-secret
REVERB_HOST="localhost"
# Internal host the app/worker containers push broadcasts to (Docker service name).
REVERB_PUSH_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Admin panel ---
# Simple shared password gate for the admin control panel.
ADMIN_PASSWORD=change-me-admin

# --- Icecast streaming ---
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_MOUNT=/stream
ICECAST_SOURCE_PASSWORD=hackme
ICECAST_ADMIN_PASSWORD=hackme
# Public stream URL the browser <audio> element connects to.
# Icecast is published on host port 8001 (nginx owns 8000).
ICECAST_PUBLIC_URL=http://localhost:8001/stream
VITE_STREAM_URL="${ICECAST_PUBLIC_URL}"

# --- Liquidsoap integration ---
# Liquidsoap polls /api/next-track with this bearer token.
LIQUIDSOAP_API_TOKEN=liquidsoap-internal-token
# Telnet control interface Laravel uses to issue request.skip.
LIQUIDSOAP_TELNET_HOST=liquidsoap
LIQUIDSOAP_TELNET_PORT=1234
# Directory of fallback tracks played when the user queue is empty.
LIQUIDSOAP_FALLBACK_DIR=/srv/fallback

# --- Skip vote tuning ---
# Window (seconds) within which a user is considered "active".
ACTIVE_USER_WINDOW=30
# Fraction of active users required to skip (0.5 = more than 50%).
SKIP_VOTE_THRESHOLD=0.5

# --- Upload limits ---
TRACK_MAX_UPLOAD_KB=15360
